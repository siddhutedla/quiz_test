# Supabase project: quiz_test_order_manager
# Copy to .env and fill in from the Supabase dashboard. Never commit .env.

# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<publishable key>"   # NEXT_PUBLIC_SUPABASE_ANON_KEY also works

# Prisma only (used by `bun run db:setup`, never shipped to the browser)
# Project Settings -> Database -> Connection string
#   DATABASE_URL = "Session" pooler string (works on IPv4)
#   DIRECT_URL   = "Direct" string (used for schema push)
DATABASE_URL="postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres"
DIRECT_URL="postgresql://postgres:<db-password>@db.<project-ref>.supabase.co:5432/postgres"
